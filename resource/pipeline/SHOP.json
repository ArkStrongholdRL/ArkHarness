{
  "Shop.SetView": {"next": ["Shop.DismissOperatorDetails", "Shop.ViewVerified", "Shop.SwitchView"], "timeout": 3500},
  "Shop.DismissOperatorDetails": {
    "recognition": "And",
    "all_of": [
      "Shop.DismissibleDetails",
      "ArkRestText",
      "Shop.ViewPreparation"
    ],
    "action": "Click",
    "target": [
      1030,
      70
    ],
    "post_delay": 250,
    "max_hit": 1,
    "next": [
      "Shop.ViewVerified",
      "Shop.SwitchView"
    ],
    "timeout": 3500
  },
  "Shop.DismissibleDetails": {
    "recognition": "Or", "any_of": ["Screen.OperatorDetailsVisible", "Shop.ConfirmLevelText"]
  },
  "Shop.ViewPreparation": {
    "recognition": "Custom", "custom_recognition": "ArkShopView", "custom_recognition_param": "preparation"
  },
  "Shop.SwitchView": {
    "recognition": "Custom", "custom_recognition": "ArkShopView", "custom_recognition_param": "switch",
    "action": "Click", "pre_delay": 200, "post_delay": 0,
    "post_wait_freezes": {"target": [1095, 625, 180, 88], "time": 150, "rate_limit": 50, "threshold": 0.99, "timeout": 650},
    "max_hit": 1, "next": ["Shop.ViewVerified"], "timeout": 3500
  },
  "Shop.ViewVerified": {
    "recognition": "Custom", "custom_recognition": "ArkShopView", "custom_recognition_param": "verify"
