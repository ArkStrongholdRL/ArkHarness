  },
  "EquipmentRead.ReadName": {
    "recognition": "Custom", "custom_recognition": "ArkEquipmentRead", "custom_recognition_param": "name"
  },
  "EquipmentRead.Name": {"recognition": "OCR", "roi": [12, 173, 210, 43]},
  "EquipmentRead.Description": {"recognition": "OCR", "roi": [94, 446, 350, 230]}
