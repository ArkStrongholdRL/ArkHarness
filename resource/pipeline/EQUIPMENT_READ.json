    "recognition": "OCR", "only_rec": true
  },
  "EquipChoice.ReplaceButton": {
    "recognition": "OCR", "expected": "^销毁并替换$", "replace": [["^销毁井替换$", "销毁并替换"]]
  },
  "EquipChoice.ReplaceConfirm": {
    "recognition": "OCR", "expected": "^确认销毁$"
  },
